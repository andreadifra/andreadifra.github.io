# Quarto website specific files to ignore
/.quarto/
/_site/
/.jupyter_cache/
/.luarc.json
/.quarto-preflight/
/.venv/
/node_modules/
/.scratch/

# R specific
.Rproj.user
.Rhistory
**/.Rhistory
.RData
.Ruserdata

# Python specific
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Editor specific
.vscode/
.idea/
*.swp
*~

# Keep _freeze/ committed for reproducible website builds.
# Ignore local knitr chunk caches created by #| cache: true.
**/index_*/

**/*.quarto_ipynb
